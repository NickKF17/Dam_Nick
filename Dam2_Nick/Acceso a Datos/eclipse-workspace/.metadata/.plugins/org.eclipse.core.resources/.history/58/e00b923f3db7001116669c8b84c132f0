	public static HashMap<Integer, String> leerFichero(String fichero) {
	    HashMap<Integer, String> anipersonajes = new HashMap<>();
	    try {
	        List<String> lineas = Files.readAllLines(Path.of(fichero));
	        
	        for (String linea : lineas) {
	            // Ignorar líneas vacías
	            if (linea.trim().isEmpty()) continue;
	            
	            int espacio = linea.indexOf(" ");
	            if (espacio != -1) {
	                int id = Integer.parseInt(linea.substring(0, espacio));
	                String valor = linea.substring(espacio + 1).trim();
	                anipersonajes.put(id, valor);
	            }
	        }   
	    } catch (Exception e) {
	        System.out.println("Error al leer el archivo " + fichero + ": " + e.getMessage());
	    }
	    return anipersonajes;
	}
}

