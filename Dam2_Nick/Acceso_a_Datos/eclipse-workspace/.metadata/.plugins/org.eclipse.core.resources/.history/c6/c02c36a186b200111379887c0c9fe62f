package Ficheros;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.HashMap;
import java.util.List;

public class Ejercicio1 {

	public static void main(String[] args) throws Exception{
	leerFichero("personajes.txt");

	}
public static HashMap<Integer, String> leerFichero(String fichero) throws Exception{
	HashMap<Integer, String> anipersonajes=new HashMap<Integer, String>();
	try {
		List<String> lineas = Files.readAllLines(Path.of("personajes.txt"));
		
		for(String anime:lineas) {
			System.out.println(anime.substring(0,anime.indexOf(" ")));
		}	
	}catch(Exception e){
		System.out.println("Error al leer el archivo: " + e.getMessage());
		
	}
	
	return anipersonajes;
}
}
