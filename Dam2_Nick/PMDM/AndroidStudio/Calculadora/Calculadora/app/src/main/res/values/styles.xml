<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Pantallas (TextView) -->

    <!-- Pantalla principal: número actual o resultado (grande) -->
    <style name="Calculator.Display.Main" parent="">
        <item name="android:textColor">@color/calc_display_main_text</item>
        <item name="android:textSize">56sp</item>
        <item name="android:gravity">end|center_vertical</item> <!-- texto pegado a la derecha -->
        <item name="android:maxLines">1</item>                  <!-- solo una línea -->
        <item name="android:ellipsize">none</item>
        <!-- Si el número es muy largo, la letra se encoge sola para que quepa -->
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">24sp</item>
        <item name="autoSizeMaxTextSize">56sp</item>
    </style>

    <!-- Pantalla secundaria: expresión en curso (más pequeña y gris) -->
    <style name="Calculator.Display.Secondary" parent="">
        <item name="android:textColor">@color/calc_display_secondary_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- BOTONES  -->

    <!-- Estilo base de todos los botones: lo que comparten todos -->
    <style name="Calculator.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">26sp</item>
        <item name="android:textAllCaps">false</item>  <!-- respeta mayúsculas/minúsculas -->
        <item name="cornerRadius">24dp</item>          <!-- esquinas redondeadas -->
        <item name="android:insetTop">0dp</item>       <!-- quita huecos internos del botón -->
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- Botones numéricos (0-9 y el punto decimal) -->
    <style name="Calculator.Button.Number">
        <item name="backgroundTint">@color/calc_number_bg</item>
        <item name="android:textColor">@color/calc_number_text</item>
    </style>

    <!-- Botones de operadores básicos (+ - × ÷) -->
    <style name="Calculator.Button.Operator">
        <item name="backgroundTint">@color/calc_operator_bg</item>
        <item name="android:textColor">@color/calc_operator_text</item>
    </style>

    <!-- Botones de acciones especiales (C, DEL, ±) -->
    <style name="Calculator.Button.Special">
        <item name="backgroundTint">@color/calc_special_bg</item>
        <item name="android:textColor">@color/calc_special_text</item>
    </style>

    <!-- Botón destacado de igual (=) -->
    <style name="Calculator.Button.Equals">
        <item name="backgroundTint">@color/calc_equals_bg</item>
        <item name="android:textColor">@color/calc_equals_text</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
